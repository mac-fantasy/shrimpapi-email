{
  "from": "ShrimpAPI <hello@yourdomain.com>",
  "reply_to": "support@yourdomain.com",
  "subject": "{{name}}，欢迎注册 {{product}}",
  "html": "../assets/templates/new-user-registration.html",
  "text": "../assets/templates/new-user-registration.txt",
  "variables": {
    "product": "ShrimpAPI",
    "support_email": "support@yourdomain.com",
    "welcome_message": "感谢注册，欢迎开始使用模型 API 服务。",
    "console_url": "https://yourdomain.com/console",
    "docs_url": "https://yourdomain.com/docs"
  },
  "rules": [
    {
      "match": "*@example.com",
      "variables": {
        "welcome_message": "欢迎加入团队，前往控制台开始协作。",
        "docs_url": "https://yourdomain.com/docs/team"
      }
    },
    {
      "match": "alice@example.com",
      "variables": {
        "console_url": "https://yourdomain.com/console/alice"
      }
    }
  ],
  "recipients": [
    {
      "email": "alice@example.com",
      "name": "Alice"
    },
    {
      "email": "bob@example.com",
      "name": "Bob",
      "variables": {
        "welcome_message": "欢迎使用专业服务，如需接入帮助请联系我们。",
        "console_url": "https://yourdomain.com/console/bob"
      }
    },
    "carol@example.net"
  ]
}
